# Copy to .env (gitignored). Never commit real keys.
# --- LLM providers (harnesses) ---
ANTHROPIC_API_KEY=            # QM (HARNESS=pi|claude-code), Claude Code
OPENAI_API_KEY=
OPENROUTER_API_KEY=
UFO_ANTHROPIC_API_KEY=        # UFO self-host REFUSES bare ANTHROPIC_API_KEY
UFO_OPENAI_API_KEY=
# --- River AI (console.river.ai) ---
RIVER_API_KEY=rv_...
RIVER_MODEL=Qwen/Qwen3.5-9B
# --- Memorable (memorable.sh/dash) ---
MEMORABLE_API_KEY=mk_...
MEMORABLE_BASE=https://memorable-extraction-api.memorable.workers.dev
# MEMORABLE=1 / QM_MEMORABLE=0 (QM relay switch / kill switch); GBRAIN_MEMORABLE=0 (gbrain kill switch)
# --- Superset SDK (alpha) ---
SUPERSET_API_KEY=sk_live_...
SUPERSET_ORGANIZATION_ID=
# --- GBrain remote (only if using gbrain serve --http / connect) ---
GBRAIN_REMOTE_TOKEN=
# --- QM local ---
ORG_ID=hack
HARNESS=pi
# DATABASE_URL=postgres://...   SESSION_STORE=postgres
# MEMORY_PROVIDER_CONFIG={"providers":[...],"routes":[...]}   (see kb/sponsors/qm.md)
# gbrain.io hosted workspace (product/company brain)
GBRAIN_IO_URL=https://gbrain.io/mcp
GBRAIN_IO_TOKEN=gbu_c_...
